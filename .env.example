# Backend only. Never prefix this key with VITE_. Keep .env out of Git.
NASA_API_KEY=your-key-from-api.nasa.gov
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
NASA_ENABLED=true
DONKI_ENABLED=true
CACHE_DIR=.cache/nasa
CACHE_MAX_ENTRIES=100
NASA_TIMEOUT_MS=8000
NASA_RETRIES=2
NASA_HOURLY_BUDGET=200
NEO_REFRESH_SECONDS=3600
APOD_REFRESH_SECONDS=3600
IMAGES_CACHE_SECONDS=86400
DONKI_REFRESH_SECONDS=1800
REFRESH_TICK_SECONDS=60
API_RATE_LIMIT=120
TRUST_PROXY_HOPS=0
# Exact comma-separated origins, only needed for separately hosted frontend.
FRONTEND_ORIGINS=
# Public build-time value: blank means same-origin /api. No key or credentials.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:3001
