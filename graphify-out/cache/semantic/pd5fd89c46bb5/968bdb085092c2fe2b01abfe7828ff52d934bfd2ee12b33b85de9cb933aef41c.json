{"nodes": [{"id": "pages_about_page", "label": "About Cosmic Explorer Page", "file_type": "document", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "csci_3230u_web_development", "label": "CSCI 3230U \u2014 Web Development Course", "file_type": "concept", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "react_vite_migration", "label": "React + Vite Migration (M2/M3)", "file_type": "rationale", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The course brief requires each team to build a single-page application with a searchable, filterable card collection, detail pages, favourites and API-loaded data, so the static HTML/CSS prototype is deliberately rebuilt as a React + Vite app with live NASA data, client-side routing and tests across milestones M2 and M3."}, {"id": "favourites_localstorage", "label": "Favourites Persisted in localStorage", "file_type": "rationale", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Favourites are stored client-side in localStorage so users can keep objects they find and have them accessible across sessions without requiring a backend account system."}, {"id": "accessibility_requirements", "label": "Accessibility & Responsive Design Requirements", "file_type": "rationale", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mobile-first layout, WCAG AA contrast, semantic HTML, keyboard navigation and screen-reader support are required so the product is usable by everyone; these constraints shape the markup and CSS choices throughout the prototype."}, {"id": "team_cosmic_explorer", "label": "Team Cosmic Explorer", "file_type": "concept", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each member owns a vertical slice of the product built on a shared app shell, so ownership is split by feature area rather than by layer."}, {"id": "pages_about_maryam", "label": "Maryam \u2014 Project Lead / Frontend", "file_type": "concept", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pages_about_dhruv", "label": "Dhruv \u2014 API / Data & Search", "file_type": "concept", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pages_about_nithin", "label": "Nithin \u2014 Object Details / Missions", "file_type": "concept", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pages_about_gamze", "label": "Gamze \u2014 UI / Accessibility", "file_type": "concept", "source_file": "pages/about.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "pages_about_page", "target": "csci_3230u_web_development", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pages/about.html", "source_location": null, "weight": 1.0}, {"source": "pages_about_page", "target": "nasa_open_apis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pages/about.html", "source_location": null, "weight": 1.0}, {"source": "pages_about_page", "target": "apod_dataset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "pages/about.html", "source_location": null, "weigh